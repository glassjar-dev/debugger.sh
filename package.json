{
  "name": "debugger.sh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run build:cs106b && npm run copy:engine-wasm && npm run copy:intellisense",
    "dev": "next dev",
    "dev:api": "mkdir -p out && wrangler dev --port 8787",
    "prebuild": "npm run build:cs106b && npm run copy:engine-wasm && npm run copy:intellisense",
    "build": "next build",
    "preview": "npm run build && wrangler dev",
    "build:cs106b": "node cs106b/scripts/build-precompiled.mjs",
    "copy:engine-wasm": "node scripts/copy-engine-wasm.mjs",
    "test:smoke": "node scripts/smoke-prepare.mjs && node --experimental-strip-types scripts/smoke-engine.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "copy:intellisense": "node scripts/copy-intellisense.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "browser-basedpyright": "^1.40.2",
    "debugger-sh": "npm:glassjar@^0.7.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.64.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.11.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261102.1": true
  }
}
